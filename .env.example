# Chatbot API Configuration
# Copy this file to .env and fill in your values

# OPTION 1: Backend API (RECOMMENDED - Secure)
# Deploy the chatbot-api folder to Vercel/Netlify and use the API URL here
REACT_APP_CHATBOT_API_URL=https://your-project.vercel.app/api/chat

# OPTION 2: Direct OpenAI API (NOT RECOMMENDED - Exposes API key)
# Only use this if you don't have a backend API deployed
# WARNING: This will expose your OpenAI API key in the frontend code!
# REACT_APP_OPENAI_API_KEY=sk-your-openai-api-key-here
